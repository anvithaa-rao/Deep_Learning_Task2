{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyPTm7tyUzsG20Ynebex/fF+"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["PART B — RNN / LSTM / GRU (Time-Series Prediction)"],"metadata":{"id":"Uv8iXDWAkBrp"}},{"cell_type":"markdown","source":["STEP 1: IMPORTS"],"metadata":{"id":"jK8js6_-kBfu"}},{"cell_type":"code","execution_count":1,"metadata":{"id":"eHP_IXINjojG","executionInfo":{"status":"ok","timestamp":1774199990574,"user_tz":-330,"elapsed":3349,"user":{"displayName":"NNM23IS020 ANVITHA V RAO","userId":"16008035803162151085"}}},"outputs":[],"source":["import torch\n","import torch.nn as nn\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")"]},{"cell_type":"markdown","source":["STEP 2: CREATE DATASET"],"metadata":{"id":"ocFiDWxhkT_H"}},{"cell_type":"code","source":["# Generate sine wave data\n","t = np.linspace(0, 100, 1000)\n","data = np.sin(t)\n","\n","# Create sequences\n","def create_sequences(data, seq_length):\n","    xs, ys = [], []\n","    for i in range(len(data)-seq_length):\n","        x = data[i:i+seq_length]\n","        y = data[i+seq_length]\n","        xs.append(x)\n","        ys.append(y)\n","    return np.array(xs), np.array(ys)\n","\n","seq_length = 20\n","X, y = create_sequences(data, seq_length)\n","\n","# Convert to tensors\n","X = torch.tensor(X, dtype=torch.float32).unsqueeze(-1)\n","y = torch.tensor(y, dtype=torch.float32).unsqueeze(-1)\n","\n","# Train-test split\n","train_size = int(0.8 * len(X))\n","X_train, X_test = X[:train_size], X[train_size:]\n","y_train, y_test = y[:train_size], y[train_size:]"],"metadata":{"id":"XZe5wr61kBB8","executionInfo":{"status":"ok","timestamp":1774200133338,"user_tz":-330,"elapsed":75,"user":{"displayName":"NNM23IS020 ANVITHA V RAO","userId":"16008035803162151085"}}},"execution_count":2,"outputs":[]},{"cell_type":"markdown","source":["STEP 3: DEFINE MODELS"],"metadata":{"id":"HBE41xg7kdZU"}},{"cell_type":"code","source":["class RNNModel(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","        self.rnn = nn.RNN(input_size=1, hidden_size=50, batch_first=True)\n","        self.fc = nn.Linear(50, 1)\n","\n","    def forward(self, x):\n","        out, _ = self.rnn(x)\n","        return self.fc(out[:, -1, :])"],"metadata":{"id":"IO5iBIskkaUU","executionInfo":{"status":"ok","timestamp":1774200148108,"user_tz":-330,"elapsed":12,"user":{"displayName":"NNM23IS020 ANVITHA V RAO","userId":"16008035803162151085"}}},"execution_count":3,"outputs":[]},{"cell_type":"markdown","source":["LSTM"],"metadata":{"id":"pgRAHqv0kjk4"}},{"cell_type":"code","source":["class LSTMModel(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","        self.lstm = nn.LSTM(input_size=1, hidden_size=50, batch_first=True)\n","        self.fc = nn.Linear(50, 1)\n","\n","    def forward(self, x):\n","        out, _ = self.lstm(x)\n","        return self.fc(out[:, -1, :])"],"metadata":{"id":"WzdEFnWxkj_c","executionInfo":{"status":"ok","timestamp":1774200205964,"user_tz":-330,"elapsed":30,"user":{"displayName":"NNM23IS020 ANVITHA V RAO","userId":"16008035803162151085"}}},"execution_count":4,"outputs":[]},{"cell_type":"markdown","source":["GRU"],"metadata":{"id":"ZvJx4e8Ekr3G"}},{"cell_type":"code","source":["class GRUModel(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","        self.gru = nn.GRU(input_size=1, hidden_size=50, batch_first=True)\n","        self.fc = nn.Linear(50, 1)\n","\n","    def forward(self, x):\n","        out, _ = self.gru(x)\n","        return self.fc(out[:, -1, :])"],"metadata":{"id":"miV5_WbGkvCS","executionInfo":{"status":"ok","timestamp":1774200232872,"user_tz":-330,"elapsed":11,"user":{"displayName":"NNM23IS020 ANVITHA V RAO","userId":"16008035803162151085"}}},"execution_count":5,"outputs":[]},{"cell_type":"markdown","source":["STEP 4: TRAINING FUNCTION"],"metadata":{"id":"7hynHe-fkyU1"}},{"cell_type":"code","source":["def train_model(model, X_train, y_train, epochs=20):\n","    model.to(device)\n","    criterion = nn.MSELoss()\n","    optimizer = torch.optim.Adam(model.parameters(), lr=0.001)\n","\n","    losses = []\n","\n","    for epoch in range(epochs):\n","        model.train()\n","\n","        X_train_batch = X_train.to(device)\n","        y_train_batch = y_train.to(device)\n","\n","        optimizer.zero_grad()\n","        outputs = model(X_train_batch)\n","        loss = criterion(outputs, y_train_batch)\n","        loss.backward()\n","        optimizer.step()\n","\n","        losses.append(loss.item())\n","\n","        if epoch % 5 == 0:\n","            print(f\"Epoch {epoch}, Loss: {loss.item()}\")\n","\n","    return losses"],"metadata":{"id":"rNXQ5GJQk2dW","executionInfo":{"status":"ok","timestamp":1774200263376,"user_tz":-330,"elapsed":44,"user":{"displayName":"NNM23IS020 ANVITHA V RAO","userId":"16008035803162151085"}}},"execution_count":6,"outputs":[]},{"cell_type":"markdown","source":["STEP 5: EVALUATION (RMSE)"],"metadata":{"id":"VdFB6WOzk59K"}},{"cell_type":"code","source":["def evaluate_model(model, X_test, y_test):\n","    model.eval()\n","\n","    with torch.no_grad():\n","        preds = model(X_test.to(device)).cpu()\n","\n","    rmse = torch.sqrt(torch.mean((preds - y_test)**2))\n","    print(\"RMSE:\", rmse.item())\n","\n","    return preds"],"metadata":{"id":"9GquJW4Dk9pn","executionInfo":{"status":"ok","timestamp":1774200294658,"user_tz":-330,"elapsed":14,"user":{"displayName":"NNM23IS020 ANVITHA V RAO","userId":"16008035803162151085"}}},"execution_count":7,"outputs":[]},{"cell_type":"markdown","source":["STEP 6: TRAIN ALL MODELS"],"metadata":{"id":"3mIdM8PdlBwp"}},{"cell_type":"code","source":["rnn = RNNModel()\n","lstm = LSTMModel()\n","gru = GRUModel()\n","\n","loss_rnn = train_model(rnn, X_train, y_train)\n","loss_lstm = train_model(lstm, X_train, y_train)\n","loss_gru = train_model(gru, X_train, y_train)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"6mpMJ0EhlEtB","executionInfo":{"status":"ok","timestamp":1774200332276,"user_tz":-330,"elapsed":10542,"user":{"displayName":"NNM23IS020 ANVITHA V RAO","userId":"16008035803162151085"}},"outputId":"e0439f3c-b7b2-4a1c-9ba0-b3e75122e84c"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["Epoch 0, Loss: 0.5087773203849792\n","Epoch 5, Loss: 0.38668641448020935\n","Epoch 10, Loss: 0.25816595554351807\n","Epoch 15, Loss: 0.12168969959020615\n","Epoch 0, Loss: 0.4754524230957031\n","Epoch 5, Loss: 0.4331390857696533\n","Epoch 10, Loss: 0.3921005427837372\n","Epoch 15, Loss: 0.34757116436958313\n","Epoch 0, Loss: 0.481856107711792\n","Epoch 5, Loss: 0.4009462594985962\n","Epoch 10, Loss: 0.3272729218006134\n","Epoch 15, Loss: 0.25926628708839417\n"]}]},{"cell_type":"markdown","source":["STEP 7: EVALUATE"],"metadata":{"id":"HwaqdYJslKzq"}},{"cell_type":"code","source":["pred_rnn = evaluate_model(rnn, X_test, y_test)\n","pred_lstm = evaluate_model(lstm, X_test, y_test)\n","pred_gru = evaluate_model(gru, X_test, y_test)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"nv62c6B7lPbO","executionInfo":{"status":"ok","timestamp":1774200366746,"user_tz":-330,"elapsed":46,"user":{"displayName":"NNM23IS020 ANVITHA V RAO","userId":"16008035803162151085"}},"outputId":"5a2ab8a5-0ab3-4d1f-bc2b-20d4b04e1c0b"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["RMSE: 0.2695651054382324\n","RMSE: 0.5411944389343262\n","RMSE: 0.43840670585632324\n"]}]},{"cell_type":"markdown","source":["STEP 8: LOSS GRAPH (VERY IMPORTANT FOR MARKS)"],"metadata":{"id":"gEUPTUgHlTIT"}},{"cell_type":"code","source":["plt.plot(loss_rnn, label=\"RNN\")\n","plt.plot(loss_lstm, label=\"LSTM\")\n","plt.plot(loss_gru, label=\"GRU\")\n","plt.legend()\n","plt.title(\"Training Loss Compari